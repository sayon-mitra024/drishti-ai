# Drishti AI — environment variables
#
# HF_TOKEN (required in production)
# Server-only Hugging Face access token used to call the private inference
# Space at sayon-mitra024/drishti-ai-inference via @gradio/client. Needs at
# least read access to the Space. NEVER prefix this with NEXT_PUBLIC_ — it
# must never be sent to the browser. Get a token at
# https://huggingface.co/settings/tokens and add it in Project Settings →
# Vars (or your deployment platform's environment variable settings).
HF_TOKEN=

# Optional: override the Hugging Face Space ID the app connects to.
# Defaults to sayon-mitra024/drishti-ai-inference if unset.
HF_SPACE_ID=

# MOCK_MODE (optional, local development only)
# When unset or "false" (default), /api/predict calls the real Hugging Face
# backend above. Set to "true" only for local UI development when HF_TOKEN
# is not configured yet — this uses an isolated deterministic heuristic
# (lib/mock-inference.ts) instead of the real model and must never be left
# "true" in a deployment presented as using the real model.
MOCK_MODE=false
